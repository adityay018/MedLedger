# MedLedger Backend Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# CORS Allowed Origins
# Specify comma-separated origins that are permitted to make API requests to this backend
# Include your Netlify frontend URL and local dev URLs
CORS_ORIGIN=https://med-ledger.netlify.app,http://localhost:5173,http://localhost:3000

# Authentication & Security
# Generate a strong, random 256-bit string for JWT signing:
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_crypto_random_secret_in_production
JWT_EXPIRES_IN=8h

# Initial Administrator Bootstrap (Optional for CLI bootstrap command)
# Used when running: npm run bootstrap:admin
# If omitted, the bootstrap tool securely generates a random cryptographic password and displays it once.
ADMIN_EMAIL=admin@medledger.io
ADMIN_PASSWORD=

# Oracle Database Credentials
# For local Oracle XE or Oracle 21c (Default PDB is often XEPDB1 or ORCLPDB1):
# DB_CONNECT_STRING=localhost:1521/XEPDB1
# For cloud Oracle Autonomous Database (ATP / ADW) or remote Oracle instance:
# DB_CONNECT_STRING=dbhost.example.com:1521/ORCLPDB1
DB_USER=medledger
DB_PASSWORD=medledger_pass
DB_CONNECT_STRING=localhost:1521/XEPDB1

# Simulation Database Mode
# Set to true to force built-in in-memory simulation mode (all 13 BCNF tables active)
# If false, backend connects to live Oracle DB if reachable, or activates resilient fallback
USE_MOCK_DB=false
