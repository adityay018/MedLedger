# MedLedger Backend Configuration
PORT=5000
NODE_ENV=development

# Oracle Database Credentials
# For local Oracle XE or Oracle 21c (Default PDB is often XEPDB1 or ORCLPDB1)
DB_USER=medledger
DB_PASSWORD=medledger_pass
DB_CONNECT_STRING=localhost:1521/XEPDB1

# Set to true to force built-in local simulation database even if Oracle is configured
# If false, backend automatically attempts OracleDB connection, and seamlessly
# activates resilient fallback if Oracle instance is not yet running.
USE_MOCK_DB=false
