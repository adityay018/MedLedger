# MedLedger Frontend Environment Configuration
# Set VITE_API_URL in Netlify Site Settings (Build & Deploy -> Environment Variables)
# Example for Render deployment: https://medledger-backend.onrender.com/api
# Example for Railway deployment: https://medledger-production.up.railway.app/api
# Example for local development: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api
